#!/bin/sh

# bueller - District Chronic Absence Report Generator
# Usage: bueller DATA.csv "District Name"

# Help function
show_help() {
    echo "District Chronic Absence Report Generator"
    echo "Usage: bueller DATA.csv \"DISTRICT_NAME\""
    echo ""
    echo "Required arguments:"
    echo "  DATA.csv         Student-level chronic absence data file"
    echo "  DISTRICT_NAME    Name of district to analyze"
    echo ""
    echo "Optional arguments:"
    echo "  --help          Show this help message"
    echo ""
    echo "Examples:"
    echo "  bueller data.csv \"Springfield District\""
    echo "  bueller ~/my_data.csv \"Metro Schools\""
    echo ""
}

# Check for help
if [ $# -eq 0 ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    show_help
    exit 0
fi

# Validate arguments
if [ $# -lt 2 ]; then
    echo "Error: Missing required arguments"
    echo ""
    show_help
    exit 1
fi

DATA_FILE="$1"
DISTRICT_NAME="$2"

# Check if data file exists
if [ ! -f "$DATA_FILE" ]; then
    echo "Error: Data file '$DATA_FILE' not found"
    exit 1
fi

# Check if R is available
if ! command -v R >/dev/null 2>&1; then
    echo "Error: R is not installed or not in PATH"
    exit 1
fi

# Check if Quarto is available
if ! command -v quarto >/dev/null 2>&1; then
    echo "Error: Quarto is not installed or not in PATH"
    echo "Please install Quarto from https://quarto.org/"
    exit 1
fi

echo "Checking for bueller package..."

# Check if bueller package is installed and install if needed
R --slave --no-restore --no-save -e "
if (!require('bueller', quietly = TRUE)) {
    cat('bueller package not found. Installing from GitHub...\n')
    if (!require('devtools', quietly = TRUE)) {
        install.packages('devtools', repos = 'https://cloud.r-project.org')
    }
    devtools::install_github('your-username/bueller')
    library(bueller)
    cat('bueller package installed successfully.\n')
} else {
    cat('bueller package is already installed.\n')
}
"

# Check if package installation was successful
if [[ $? -ne 0 ]]; then
    echo "Error: Failed to install or load bueller package"
    exit 1
fi

echo "Generating district report..."

# Run the district analysis
R --slave --no-restore --no-save -e "
library(bueller)
tryCatch({
    render_district('$DATA_FILE', '$DISTRICT_NAME')
}, error = function(e) {
    cat('Error:', e\$message, '\n')
    quit(status = 1)
})
"

# Check if R command was successful
if [ $? -eq 0 ]; then
    echo "Report generation completed successfully!"
else
    echo "Error: Report generation failed"
    exit 1
fi
