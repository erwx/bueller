#!/usr/bin/env Rscript

# bueller - Chronic Absence Analyzer CLI
# POSIX-compliant command line interface

# Parse command line arguments
args <- commandArgs(trailingOnly = TRUE)

# Help message
show_help <- function() {
  cat("Chronic Absence Analyzer\n")
  cat("Usage: bueller DATA.csv --baseline YEAR --reduction PCT",
      "--years NUM [options]\n\n")
  cat("Required arguments:\n")
  cat("  DATA.csv           Student-level chronic absence data file\n")
  cat("  --baseline YEAR    Baseline year for analysis\n")
  cat("  --reduction PCT    Target reduction percentage",
      "(e.g., 50 for 50%)\n")
  cat("  --years NUM        Years to achieve reduction goal\n\n")
  cat("Optional arguments:\n")
  cat("  --output FILE      Output report filename",
      "(default: report.html)\n")
  cat("  --help            Show this help message\n\n")
  cat("Examples:\n")
  cat("  bueller data.csv --baseline 2021 --reduction 50 --years 5\n")
  cat("  bueller data.csv --baseline 2020 --reduction 30 --years 3",
      "--output custom.html\n")
}

# Check for help
if (length(args) == 0 || "--help" %in% args || "-h" %in% args) {
  show_help()
  quit(status = 0)
}

# Validate minimum arguments (file + 3 flag pairs = 7 minimum)
if (length(args) < 7) {
  cat("Error: Missing required arguments\n\n")
  show_help()
  quit(status = 1)
}

# Parse arguments
data_file <- args[1]
baseline_year <- NULL
reduction_pct <- NULL
years_to_goal <- NULL
output_file <- "report.html"

# Simple argument parser
for (i in seq_along(args)) {
  if (args[i] == "--baseline" && i < length(args)) {
    baseline_year <- as.numeric(args[i + 1])
  } else if (args[i] == "--reduction" && i < length(args)) {
    reduction_pct <- as.numeric(args[i + 1])
  } else if (args[i] == "--years" && i < length(args)) {
    years_to_goal <- as.numeric(args[i + 1])
  } else if (args[i] == "--output" && i < length(args)) {
    output_file <- args[i + 1]
  }
}

# Validate required parameters
if (is.null(baseline_year) || is.na(baseline_year)) {
  cat("Error: Invalid baseline year\n")
  quit(status = 1)
}

if (is.null(reduction_pct) || is.na(reduction_pct) || 
    reduction_pct <= 0 || reduction_pct > 100) {
  cat("Error: Reduction percentage must be between 1 and 100\n")
  quit(status = 1)
}

if (is.null(years_to_goal) || is.na(years_to_goal) || 
    years_to_goal <= 0) {
  cat("Error: Years to goal must be greater than 0\n")
  quit(status = 1)
}

# Check data file exists
if (!file.exists(data_file)) {
  cat("Error: Data file", data_file, "not found\n")
  quit(status = 1)
}

# Load required package
suppressMessages({
  if (!require("bueller", quietly = TRUE)) {
    cat("Error: bueller package not installed\n")
    cat("Please install with: install.packages('bueller')\n")
    quit(status = 1)
  }
})

# Load data
cat("Loading data from", data_file, "...\n")
tryCatch({
  if (grepl("\\.csv$", data_file, ignore.case = TRUE)) {
    data <- read.csv(data_file, stringsAsFactors = FALSE)
  } else if (grepl("\\.rds$", data_file, ignore.case = TRUE)) {
    data <- readRDS(data_file)
  } else {
    cat("Error: Unsupported file format. Use .csv or .rds files\n")
    quit(status = 1)
  }
}, error = function(e) {
  cat("Error loading data:", e[["message"]], "\n")
  quit(status = 1)
})

# Validate data structure
required_cols <- c("STUDENT_ID", "YEAR", "SCHOOL_NAME", 
                   "DISTRICT_NAME", "COUNTY_NAME", "CHRONIC_ABSENT")
missing_cols <- setdiff(required_cols, names(data))
if (length(missing_cols) > 0) {
  cat("Error: Missing required columns:", 
      paste(missing_cols, collapse = ", "), "\n")
  quit(status = 1)
}

# Run analysis pipeline
cat("Running chronic absence analysis...\n")
tryCatch({
  analysis_results <- analyze(data, baseline_year, reduction_pct, 
                             years_to_goal)
}, error = function(e) {
  cat("Error in analysis:", e[["message"]], "\n")
  quit(status = 1)
})

# Generate report
cat("Generating report...\n")

# Save analysis results to temporary file
temp_results_file <- tempfile(fileext = ".rds")
saveRDS(analysis_results, temp_results_file)

# Create simple working report first
temp_qmd <- file.path(getwd(), "temp_report.qmd")

writeLines(c(
  "---",
  "title: \"Chronic Absence Analysis Report\"", 
  "format:",
  "  html:",
  "    toc: true",
  "    embed-resources: true",
  "    theme: minty",
  "date: today",
  "execute:",
  "  echo: false",
  "  warning: false",
  "  message: false",
  "---",
  "",
  "```{r setup}",
  paste0("analysis_results <- readRDS('", temp_results_file, "')"),
  "current <- analysis_results$current_results",
  "trends <- analysis_results$trend_results",
  "baseline <- analysis_results$baseline_results",
  "targets <- analysis_results$target_results", 
  "priorities <- analysis_results$priority_results",
  "hotspots <- analysis_results$hotspot_results",
  "demo <- analysis_results$demo_results",
  "params <- analysis_results$parameters",
  "format_pct <- function(x) paste0(round(x * 100, 1), '%')",
  "format_num <- function(x) format(x, big.mark = ',')",
  "```",
  "",
  "# Introduction",
  "",
  "Chronic absenteeism is defined as missing 10% or more of enrolled school days for any reason. Chronic absence is related to academic risk and lower academic achievement, grade retention, and increased dropout rates. This analysis examines chronic absence patterns across geographic areas and demographic groups to identify priority areas for intervention.",
  "",
  "# Current Year Summary",
  "",
  paste0("In `r current$overview$year`, the state served `r format_num(current$overview$total_students)` students across `r current$overview$n_counties` counties, `r current$overview$n_districts` districts, and `r current$overview$n_schools` schools. Of these students, `r format_num(current$overview$chronic_absent)` (`r format_pct(current$overview$chronic_rate)`) were chronically absent. This represents a substantial population of students missing critical instructional time. The current year's enrollment of `r format_num(current$overview$total_students)` students is distributed across `r current$overview$n_schools` schools, averaging `r round(current$overview$total_students / current$overview$n_schools, 0)` students per school. The `r current$overview$n_districts` districts vary significantly in size, with the largest districts serving thousands of students while smaller districts may serve only hundreds. County-level enrollment ranges from the smallest counties serving fewer than 500 students to the largest serving over 15,000 students. The statewide chronic absence rate of `r format_pct(current$overview$chronic_rate)` means that more than one in three students missed 10% or more of enrolled school days. Grade-level enrollment is not evenly distributed, with `r paste(current$grade_distribution$GRADE[order(-current$grade_distribution$TOTAL_STUDENTS)][1:2], collapse = ' and ')` representing the largest grades by enrollment. The current year shows `r format_num(current$overview$chronic_absent)` chronically absent students requiring intervention services, support, or modified approaches to improve attendance patterns. County-level data reveals substantial variation, with counties reporting between `r format_num(min(current$county_summary$TOTAL_STUDENTS))` and `r format_num(max(current$county_summary$TOTAL_STUDENTS))` students. District enrollment patterns show similar variation, from small rural districts with fewer than 100 students to large urban districts serving thousands across multiple schools and communities."),
  "",
  "## Current Performance by Grade",
  "",
  paste0("Chronic absence rates vary across grade levels in `r current$overview$year`. The data reveals important patterns in how attendance challenges manifest across the K-8 spectrum. Grade `r current$grade_distribution$GRADE[which.max(current$grade_distribution$CHRONIC_RATE)]` shows the highest chronic absence rate at `r format_pct(max(current$grade_distribution$CHRONIC_RATE))`, while grade `r current$grade_distribution$GRADE[which.min(current$grade_distribution$CHRONIC_RATE)]` has the lowest rate at `r format_pct(min(current$grade_distribution$CHRONIC_RATE))`. The difference between the highest and lowest grade-level rates is `r format_pct(max(current$grade_distribution$CHRONIC_RATE) - min(current$grade_distribution$CHRONIC_RATE))`, indicating meaningful variation across grade levels. `r sum(current$grade_distribution$CHRONIC_RATE > current$overview$chronic_rate)` grades have chronic absence rates above the statewide average of `r format_pct(current$overview$chronic_rate)`. The largest grades by enrollment are grades `r paste(current$grade_distribution$GRADE[order(-current$grade_distribution$TOTAL_STUDENTS)][1:3], collapse = ', ')`, which together account for `r format_pct(sum(current$grade_distribution$PERCENT_OF_TOTAL[order(-current$grade_distribution$TOTAL_STUDENTS)][1:3]))` of all students and `r format_num(sum(current$grade_distribution$CHRONIC_ABSENT[order(-current$grade_distribution$TOTAL_STUDENTS)][1:3]))` chronically absent students. Grade-level enrollment ranges from `r format_num(min(current$grade_distribution$TOTAL_STUDENTS))` students in grade `r current$grade_distribution$GRADE[which.min(current$grade_distribution$TOTAL_STUDENTS)]` to `r format_num(max(current$grade_distribution$TOTAL_STUDENTS))` students in grade `r current$grade_distribution$GRADE[which.max(current$grade_distribution$TOTAL_STUDENTS)]`. The total chronic absence counts by grade range from `r format_num(min(current$grade_distribution$CHRONIC_ABSENT))` to `r format_num(max(current$grade_distribution$CHRONIC_ABSENT))` students."),
  "",
  "```{r current-grade-table}",
  "grade_current <- current$grade_distribution",
  "grade_current$CHRONIC_RATE <- format_pct(grade_current$CHRONIC_RATE)",
  "grade_current$TOTAL_STUDENTS <- format_num(grade_current$TOTAL_STUDENTS)",
  "grade_current$CHRONIC_ABSENT <- format_num(grade_current$CHRONIC_ABSENT)",
  "grade_current$PERCENT_OF_TOTAL <- format_pct(grade_current$PERCENT_OF_TOTAL)",
  "knitr::kable(grade_current,",
  "             col.names = c('Grade', 'Total Students', 'Chronic Absent', 'Rate', '% of All Students'),",
  "             caption = paste('Chronic Absence by Grade Level -', current$overview$year))",
  "```",
  "",
  "## Current Demographic Patterns",
  "",
  paste0("Significant disparities exist across demographic groups in `r current$overview$year`. `r current$equity_analysis$groups_above_average` demographic groups have chronic absence rates above the state average of `r format_pct(current$overview$chronic_rate)`, while `r current$equity_analysis$groups_below_average` groups perform below average. The largest positive equity gap is `r format_pct(current$equity_analysis$max_gap)` above the state average for `r current$equity_analysis$largest_positive_gap` students, while the largest negative gap is `r format_pct(abs(current$equity_analysis$min_gap))` below the state average for `r current$equity_analysis$largest_negative_gap` students. The total spread between the highest and lowest performing demographic groups is `r format_pct(current$equity_analysis$max_gap - current$equity_analysis$min_gap)`. Among groups performing above the state average, `r paste(current$demographic_summary$GROUP[current$demographic_summary$GAP_FROM_STATE > 0], collapse = ', ')` students show elevated chronic absence rates. The largest demographic group by enrollment is `r current$demographic_summary$GROUP[which.max(current$demographic_summary$TOTAL_STUDENTS)]` with `r format_num(max(current$demographic_summary$TOTAL_STUDENTS))` students and a chronic absence rate of `r format_pct(current$demographic_summary$CHRONIC_RATE[which.max(current$demographic_summary$TOTAL_STUDENTS)])`. `r current$demographic_summary$GROUP[which.max(current$demographic_summary$CHRONIC_ABSENT)]` students account for the largest absolute number of chronically absent students at `r format_num(max(current$demographic_summary$CHRONIC_ABSENT))`, despite representing `r format_pct(current$demographic_summary$TOTAL_STUDENTS[which.max(current$demographic_summary$CHRONIC_ABSENT)] / current$overview$total_students)` of total enrollment. Demographic enrollment patterns show substantial variation, with group sizes ranging from `r format_num(min(current$demographic_summary$TOTAL_STUDENTS))` to `r format_num(max(current$demographic_summary$TOTAL_STUDENTS))` students. Chronic absence rates by demographic group span from `r format_pct(min(current$demographic_summary$CHRONIC_RATE))` to `r format_pct(max(current$demographic_summary$CHRONIC_RATE))`."),
  "",
  "```{r current-demographic-table}",
  "demo_current <- current$demographic_summary",
  "demo_current$CHRONIC_RATE <- format_pct(demo_current$CHRONIC_RATE)",
  "demo_current$TOTAL_STUDENTS <- format_num(demo_current$TOTAL_STUDENTS)",
  "demo_current$CHRONIC_ABSENT <- format_num(demo_current$CHRONIC_ABSENT)",
  "demo_current$GAP_FROM_STATE <- format_pct(demo_current$GAP_FROM_STATE)",
  "rownames(demo_current) <- NULL",
  "knitr::kable(demo_current[, c('GROUP', 'TOTAL_STUDENTS', 'CHRONIC_ABSENT', 'CHRONIC_RATE', 'GAP_FROM_STATE')],",
  "             col.names = c('Demographic Group', 'Total Students', 'Chronic Absent', 'Rate', 'Gap from State'),",
  "             caption = paste('Chronic Absence by Demographic Group -', current$overview$year))",
  "```",
  "",
  "## Geographic Distribution",
  "",
  paste0("Geographic variation in chronic absence rates is substantial in `r current$overview$year`. County rates range from `r format_pct(current$distribution_analysis$county_rate_range[1])` to `r format_pct(current$distribution_analysis$county_rate_range[2])`, a spread of `r format_pct(current$distribution_analysis$county_rate_range[2] - current$distribution_analysis$county_rate_range[1])`. `r current$distribution_analysis$high_rate_counties` counties have chronic absence rates exceeding 30%, affecting `r format_num(current$distribution_analysis$students_in_high_rate_counties)` students (`r format_pct(current$distribution_analysis$pct_students_high_rate)` of the statewide total). District-level rates show even greater variation, ranging from `r format_pct(current$distribution_analysis$district_rate_range[1])` to `r format_pct(current$distribution_analysis$district_rate_range[2])`. The median county chronic absence rate is `r format_pct(current$distribution_analysis$county_percentiles[3])`, while 25% of counties have rates below `r format_pct(current$distribution_analysis$county_percentiles[2])` and 25% have rates above `r format_pct(current$distribution_analysis$county_percentiles[4])`. At the 90th percentile, county rates reach `r format_pct(current$distribution_analysis$county_percentiles[5])`, while the 10th percentile is `r format_pct(current$distribution_analysis$county_percentiles[1])`. The top `r current$distribution_analysis$counties_for_50pct_students` counties by chronic absence rate account for 50% of all students in high-rate areas. `r current$distribution_analysis$high_rate_districts` districts have rates exceeding 30%. County-level student enrollment shows the largest county serves `r format_num(max(current$county_summary$TOTAL_STUDENTS))` students while the smallest serves `r format_num(min(current$county_summary$TOTAL_STUDENTS))` students. District enrollment patterns among larger districts range from `r format_num(min(current$district_summary$TOTAL_STUDENTS))` to `r format_num(max(current$district_summary$TOTAL_STUDENTS))` students."),
  "",
  "# Trends Over Time",
  "",
  paste0("Chronic absence patterns have evolved across `r length(trends$summary$years_analyzed)` years of data from `r min(trends$summary$years_analyzed)` to `r max(trends$summary$years_analyzed)`. The statewide chronic absence rate peaked at `r format_pct(max(trends$state_trends$CHRONIC_RATE))` in `r trends$state_trends$YEAR[which.max(trends$state_trends$CHRONIC_RATE)]` and declined to `r format_pct(trends$state_trends$CHRONIC_RATE[nrow(trends$state_trends)])` in `r max(trends$summary$years_analyzed)`. The largest year-over-year increase occurred between `r trends$state_trends$YEAR[which.max(trends$state_trends$YOY_CHANGE)-1]` and `r trends$state_trends$YEAR[which.max(trends$state_trends$YOY_CHANGE)]`, with an increase of `r format_pct(max(trends$state_trends$YOY_CHANGE, na.rm = TRUE))`. The largest year-over-year decrease was `r format_pct(abs(min(trends$state_trends$YOY_CHANGE, na.rm = TRUE)))` between `r trends$state_trends$YEAR[which.min(trends$state_trends$YOY_CHANGE)-1]` and `r trends$state_trends$YEAR[which.min(trends$state_trends$YOY_CHANGE)]`. Total student enrollment has changed from `r format_num(trends$state_trends$TOTAL_STUDENTS[1])` in `r trends$state_trends$YEAR[1]` to `r format_num(trends$state_trends$TOTAL_STUDENTS[nrow(trends$state_trends)])` in `r trends$state_trends$YEAR[nrow(trends$state_trends)]`, a change of `r format_num(trends$state_trends$TOTAL_STUDENTS[nrow(trends$state_trends)] - trends$state_trends$TOTAL_STUDENTS[1])` students. The number of chronically absent students peaked at `r format_num(max(trends$state_trends$CHRONIC_ABSENT))` in `r trends$state_trends$YEAR[which.max(trends$state_trends$CHRONIC_ABSENT)]` and is currently `r format_num(trends$state_trends$CHRONIC_ABSENT[nrow(trends$state_trends)])`. County trend analysis includes `r length(unique(trends$county_trends$COUNTY_NAME))` counties with data spanning multiple years. District trends cover `r length(unique(trends$district_trends$DISTRICT_NAME))` major districts with enrollments above 1,000 students."),
  "",
  "## Statewide Trends",
  "",
  paste0("The statewide chronic absence rate peaked at `r format_pct(max(trends$state_trends$CHRONIC_RATE))` in `r trends$state_trends$YEAR[which.max(trends$state_trends$CHRONIC_RATE)]` and has since declined to `r format_pct(trends$state_trends$CHRONIC_RATE[nrow(trends$state_trends)])` in `r params$current_year`. This represents a `r format_pct(abs(trends$state_trends$YOY_CHANGE[nrow(trends$state_trends)]))` improvement from the previous year. The trend analysis shows chronic absence rates began at `r format_pct(trends$state_trends$CHRONIC_RATE[1])` in `r trends$state_trends$YEAR[1]` with `r format_num(trends$state_trends$TOTAL_STUDENTS[1])` students enrolled. The rate increased to `r format_pct(trends$state_trends$CHRONIC_RATE[2])` in `r trends$state_trends$YEAR[2]`, representing a `r format_pct(trends$state_trends$YOY_CHANGE[2])` change. The peak year showed `r format_num(trends$state_trends$TOTAL_STUDENTS[which.max(trends$state_trends$CHRONIC_RATE)])` total students with `r format_num(max(trends$state_trends$CHRONIC_ABSENT))` chronically absent. Following the peak, the rate declined to `r format_pct(trends$state_trends$CHRONIC_RATE[which.max(trends$state_trends$CHRONIC_RATE) + 1])` in `r trends$state_trends$YEAR[which.max(trends$state_trends$CHRONIC_RATE) + 1]`, a `r format_pct(trends$state_trends$YOY_CHANGE[which.max(trends$state_trends$CHRONIC_RATE) + 1])` change. The most recent year shows `r format_num(trends$state_trends$TOTAL_STUDENTS[nrow(trends$state_trends)])` students with `r format_num(trends$state_trends$CHRONIC_ABSENT[nrow(trends$state_trends)])` chronically absent. Enrollment has declined by `r format_num(trends$state_trends$TOTAL_STUDENTS[1] - trends$state_trends$TOTAL_STUDENTS[nrow(trends$state_trends)])` students from the first to the most recent year. The difference between peak and current chronic absence counts is `r format_num(max(trends$state_trends$CHRONIC_ABSENT) - trends$state_trends$CHRONIC_ABSENT[nrow(trends$state_trends)])` students."),
  "",
  "```{r state-trends-table}",
  "state_trend_display <- trends$state_trends",
  "state_trend_display$CHRONIC_RATE <- format_pct(state_trend_display$CHRONIC_RATE)",
  "state_trend_display$TOTAL_STUDENTS <- format_num(state_trend_display$TOTAL_STUDENTS)",
  "state_trend_display$CHRONIC_ABSENT <- format_num(state_trend_display$CHRONIC_ABSENT)",
  "state_trend_display$YOY_CHANGE <- ifelse(is.na(state_trend_display$YOY_CHANGE), '--', format_pct(state_trend_display$YOY_CHANGE))",
  "knitr::kable(state_trend_display[, c('YEAR', 'TOTAL_STUDENTS', 'CHRONIC_ABSENT', 'CHRONIC_RATE', 'YOY_CHANGE')],",
  "             col.names = c('Year', 'Total Students', 'Chronic Absent', 'Rate', 'Year-over-Year Change'),",
  "             caption = 'Statewide Chronic Absence Trends')",
  "```",
  "",
  "## Geographic Trends",
  "",
  paste0("County-level analysis reveals significant variation in improvement patterns. `r trends$summary$most_improved_county` County showed the greatest improvement since `r params$baseline_year`, while `r trends$summary$most_declined_county` County experienced the largest increase in chronic absence rates. These patterns highlight the importance of local factors in driving attendance outcomes. County changes range from a `r format_pct(min(trends$county_changes$CHANGE))` improvement in `r trends$county_changes$COUNTY_NAME[which.min(trends$county_changes$CHANGE)]` to a `r format_pct(max(trends$county_changes$CHANGE))` increase in `r trends$county_changes$COUNTY_NAME[which.max(trends$county_changes$CHANGE)]`. The analysis covers `r length(unique(trends$county_trends$COUNTY_NAME))` counties across `r length(unique(trends$county_trends$YEAR))` years of data. `r sum(trends$county_changes$CHANGE < 0)` counties showed improvement while `r sum(trends$county_changes$CHANGE > 0)` counties showed increases. The median county change is `r format_pct(median(trends$county_changes$CHANGE))`. Counties with the largest absolute improvements had first-year rates of `r format_pct(trends$county_changes$FIRST_RATE[which.min(trends$county_changes$CHANGE)])` declining to `r format_pct(trends$county_changes$LAST_RATE[which.min(trends$county_changes$CHANGE)])`. Counties with the largest increases had first-year rates of `r format_pct(trends$county_changes$FIRST_RATE[which.max(trends$county_changes$CHANGE)])` rising to `r format_pct(trends$county_changes$LAST_RATE[which.max(trends$county_changes$CHANGE)])`. District trend analysis includes `r nrow(trends$district_trends)` district-year observations for `r length(unique(trends$district_trends$DISTRICT_NAME))` major districts. The time span for analysis ranges from `r min(trends$county_changes$FIRST_YEAR)` to `r max(trends$county_changes$LAST_YEAR)`. County percentage changes range from `r format_pct(min(trends$county_changes$PCT_CHANGE))` to `r format_pct(max(trends$county_changes$PCT_CHANGE))`."),
  "",
  "```{r county-change-table}",
  "county_change_display <- head(trends$county_changes[order(trends$county_changes$CHANGE), ], 10)",
  "county_change_display$FIRST_RATE <- format_pct(county_change_display$FIRST_RATE)",
  "county_change_display$LAST_RATE <- format_pct(county_change_display$LAST_RATE)",
  "county_change_display$CHANGE <- format_pct(county_change_display$CHANGE)",
  "rownames(county_change_display) <- NULL",
  "knitr::kable(county_change_display[, c('COUNTY_NAME', 'FIRST_YEAR', 'LAST_YEAR', 'FIRST_RATE', 'LAST_RATE', 'CHANGE')],",
  "             col.names = c('County', 'First Year', 'Last Year', 'First Rate', 'Last Rate', 'Change'),",
  "             caption = 'Top 10 Most Improved Counties (Full Period)')",
  "```",
  "",
  "## Demographic Trends",
  "",
