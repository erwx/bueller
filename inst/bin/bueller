# Render report
tryCatch({
  system(sprintf('cd "%s" && quarto render "%s" --output "%s"', 
                 getwd(), temp_qmd, output_file))
}, error = function(e) {
  cat("Error generating report:", e[["message"]], "\n")
  quit(status = 1)
})

# Cleanup
unlink(temp_qmd)
unlink(temp_results_file)

# Save message
cat("Report saved to:", output_file, "\n")
