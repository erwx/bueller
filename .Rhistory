cat("This is exactly our regression equation for house 1!\n\n")
cat("Press Enter to continue...")
readline()
# ==============================================================================
# STEP 4: CREATE THE OUTCOME VECTOR (y)
# ==============================================================================
cat("\n\n")
cat("STEP 4: Create the Outcome Vector (y)\n")
cat("======================================\n\n")
y <- price
cat("The outcome vector y:\n")
print(y)
cat("\n\n")
cat("Now our system of 8 equations can be written as ONE matrix equation:\n")
cat("  y = Xβ + ε\n\n")
cat("Where:\n")
cat("  X is 8×3 (8 houses, 3 predictors including intercept)\n")
cat("  β is 3×1 (3 coefficients we're solving for)\n")
cat("  y is 8×1 (8 house prices)\n")
cat("  ε is 8×1 (8 error terms)\n\n")
cat("Press Enter to continue...")
readline()
# ==============================================================================
# THE NORMAL EQUATIONS
# ==============================================================================
cat("\n\n")
cat("THE NORMAL EQUATIONS\n")
cat("====================\n\n")
cat("We want β that minimizes the sum of squared errors.\n")
cat("Through calculus, this β satisfies:\n\n")
cat("  X'Xβ = X'y  (the normal equations)\n\n")
cat("Solving for β:\n")
cat("  β = (X'X)⁻¹X'y\n\n")
cat("This is our magic formula! Let's compute each piece.\n\n")
cat("Press Enter to continue...")
readline()
# ==============================================================================
# STEP 5: CALCULATE X'X (transpose X times X)
# ==============================================================================
cat("\n\n")
cat("STEP 5: Calculate X'X\n")
cat("=====================\n\n")
cat("WHAT'S A TRANSPOSE?\n")
cat("-------------------\n")
cat("The transpose flips a matrix: rows become columns, columns become rows.\n\n")
cat("Original X (8×3):\n")
print(X)
cat("\n\n")
cat("Transpose of X (3×8):\n")
print(t(X))
cat("\n\n")
cat("WHY TRANSPOSE X?\n")
cat("----------------\n")
cat("We need to create a SQUARE system we can solve!\n")
cat("  X is 8×3 (not square, can't invert)\n")
cat("  X'X is 3×3 (square! we can invert this)\n\n")
cat("Press Enter to continue...")
readline()
cat("\n\n")
cat("Now computing X'X:\n\n")
XtX <- t(X) %*% X
print(XtX)
cat("\n\n")
cat("WHAT DOES X'X MEAN?\n")
cat("-------------------\n")
cat("X'X captures how predictors relate to EACH OTHER:\n\n")
cat("  XtX[1,1] = 8          → sum of 1² (number of observations)\n")
cat("  XtX[2,2] = 16,270,000 → sum of sqft² (variation in square footage)\n")
cat("  XtX[3,3] = 76         → sum of bedrooms²\n")
cat("  XtX[1,2] = 11,300     → sum of (1 × sqft) = sum of sqft\n")
cat("  XtX[2,3] = 34,200     → sum of (sqft × bedrooms)\n\n")
cat("Let's verify:\n")
cat("  sum(sqft) =", sum(sqft), "(should equal XtX[1,2] =", XtX[1,2], ")\n")
cat("  sum(sqft^2) =", sum(sqft^2), "(should equal XtX[2,2] =", XtX[2,2], ")\n")
cat("  sum(sqft * bedrooms) =", sum(sqft * bedrooms),
"(should equal XtX[2,3] =", XtX[2,3], ")\n\n")
cat("Press Enter to continue...")
readline()
# ==============================================================================
# STEP 6: CALCULATE X'y
# ==============================================================================
cat("\n\n")
cat("STEP 6: Calculate X'y\n")
cat("=====================\n\n")
Xty <- t(X) %*% y
cat("X'y:\n")
print(Xty)
cat("\n\n")
cat("WHAT DOES X'y MEAN?\n")
cat("-------------------\n")
cat("X'y captures how predictors relate to the OUTCOME:\n\n")
cat("  Xty[1] = 2,150     → sum of (1 × price) = sum of prices\n")
cat("  Xty[2] = 3,082,000 → sum of (sqft × price)\n")
cat("  Xty[3] = 6,530     → sum of (bedrooms × price)\n\n")
cat("Let's verify:\n")
cat("  sum(price) =", sum(price), "(should equal Xty[1] =", Xty[1], ")\n")
cat("  sum(sqft * price) =", sum(sqft * price),
"(should equal Xty[2] =", Xty[2], ")\n")
cat("  sum(bedrooms * price) =", sum(bedrooms * price),
"(should equal Xty[3] =", Xty[3], ")\n\n")
cat("WHY X' ON BOTH SIDES?\n")
cat("---------------------\n")
cat("The normal equations X'Xβ = X'y come from minimizing squared residuals.\n")
cat("X'X gives us predictor-to-predictor relationships (3×3 square matrix)\n")
cat("X'y gives us predictor-to-outcome relationships (3×1 vector)\n\n")
cat("Press Enter to continue...")
readline()
# ==============================================================================
# STEP 7: SOLVE FOR β
# ==============================================================================
cat("\n\n")
cat("STEP 7: Solve for β\n")
cat("===================\n\n")
cat("We solve X'Xβ = X'y for β by multiplying both sides by (X'X)⁻¹:\n\n")
cat("  (X'X)⁻¹X'Xβ = (X'X)⁻¹X'y\n")
cat("  Iβ = (X'X)⁻¹X'y        (because A⁻¹A = I, the identity matrix)\n")
cat("  β = (X'X)⁻¹X'y         (because Iβ = β)\n\n")
cat("WHAT'S AN INVERSE?\n")
cat("------------------\n")
cat("The inverse A⁻¹ is like '1/A' for matrices.\n")
cat("When you multiply A⁻¹A, you get I (the identity).\n")
cat("Just like how 3 × (1/3) = 1 for regular numbers!\n\n")
cat("Computing (X'X)⁻¹:\n")
XtX_inv <- solve(XtX)
print(XtX_inv)
cat("\n\n")
cat("Now multiplying (X'X)⁻¹ by X'y to get β:\n\n")
beta <- XtX_inv %*% Xty
print(beta)
cat("\n\n")
cat("Or in one step: β = (X'X)⁻¹X'y\n")
beta_onestep <- solve(t(X) %*% X) %*% t(X) %*% y
print(beta_onestep)
cat("\n\n")
cat("INTERPRETING THE COEFFICIENTS:\n")
cat("------------------------------\n")
cat("Our fitted equation is:\n")
cat(sprintf("  price = %.2f + %.4f × sqft + %.2f × bedrooms\n\n",
beta[1], beta[2], beta[3]))
cat(sprintf("  β₀ = %.2f: Baseline price when sqft=0 and bedrooms=0\n", beta[1]))
cat(sprintf("  β₁ = %.4f: Each additional sqft adds $%.0f to price\n",
beta[2], beta[2] * 1000))
cat(sprintf("  β₂ = %.2f: Each additional bedroom adds $%.0f to price\n",
beta[3], beta[3] * 1000))
cat("\n\n")
cat("These values MINIMIZE the sum of squared errors!\n\n")
cat("Press Enter to continue...")
readline()
# ==============================================================================
# STEP 8: VERIFY AGAINST lm()
# ==============================================================================
cat("\n\n")
cat("STEP 8: Verify We Got the Same Answer!\n")
cat("=======================================\n\n")
comparison <- data.frame(
Coefficient = c("Intercept", "sqft", "bedrooms"),
lm_result = coef(model),
our_beta = as.vector(beta)
)
print(comparison)
cat("\n\n")
cat("Are they equal (within numerical precision)?\n")
print(all.equal(coef(model), as.vector(beta)))
cat("\n\n")
cat("SUCCESS! Our manual calculation matches lm() exactly!\n\n")
cat("Press Enter to continue...")
readline()
# ==============================================================================
# STEP 9: MAKE PREDICTIONS
# ==============================================================================
cat("\n\n")
cat("STEP 9: Make Predictions\n")
cat("========================\n\n")
cat("Let's predict price for a new house: 1600 sqft, 3 bedrooms\n\n")
# Method 1: Using lm()
pred_lm <- predict(model, data.frame(sqft = 1600, bedrooms = 3))
cat("Method 1 - Using lm():\n")
cat(sprintf("  Predicted price: $%.2f thousand\n\n", pred_lm))
# Method 2: Manual calculation
new_house <- c(1, 1600, 3)  # Don't forget the 1 for intercept!
pred_manual <- sum(new_house * beta)
cat("Method 2 - Manual calculation:\n")
cat("  price = β₀×1 + β₁×sqft + β₂×bedrooms\n")
cat(sprintf("  price = %.2f×1 + %.4f×1600 + %.2f×3\n",
beta[1], beta[2], beta[3]))
cat(sprintf("  price = %.2f + %.2f + %.2f\n",
beta[1], beta[2]*1600, beta[3]*3))
cat(sprintf("  Predicted price: $%.2f thousand\n\n", pred_manual))
# Method 3: Matrix multiplication
new_house_matrix <- matrix(c(1, 1600, 3), nrow = 1)
pred_matrix <- new_house_matrix %*% beta
cat("Method 3 - Matrix multiplication:\n")
cat(sprintf("  Predicted price: $%.2f thousand\n\n", pred_matrix))
cat("All three methods give the same answer!\n")
cat(sprintf("A 1600 sqft house with 3 bedrooms is predicted to cost $%.2f thousand.\n\n",
pred_lm))
cat("Press Enter to continue...")
readline()
# ==============================================================================
# COMPLETE SUMMARY
# ==============================================================================
cat("\n\n")
cat("COMPLETE CODE SUMMARY\n")
cat("=====================\n\n")
cat("# Data\n")
cat("sqft <- c(1000, 1500, 1200, 1800, 1400, 1600, 1100, 1700)\n")
cat("bedrooms <- c(2, 3, 2, 4, 3, 3, 2, 4)\n")
cat("price <- c(200, 280, 240, 320, 270, 300, 230, 310)\n\n")
cat("# Method 1: Using lm()\n")
cat("model <- lm(price ~ sqft + bedrooms)\n")
cat("coef(model)\n\n")
cat("# Method 2: Matrix algebra\n")
cat("X <- cbind(1, sqft, bedrooms)  # Design matrix with intercept column\n")
cat("y <- price                      # Outcome vector\n")
cat("beta <- solve(t(X) %*% X) %*% t(X) %*% y\n")
cat("beta\n\n")
cat("# Verify they match\n")
cat("all.equal(coef(model), as.vector(beta))\n\n")
# ==============================================================================
# KEY TAKEAWAYS
# ==============================================================================
cat("\n")
cat("KEY TAKEAWAYS\n")
cat("=============\n\n")
cat("1. Multiple regression is a SYSTEM OF EQUATIONS (one per observation).\n")
cat("   Matrices let us write all equations compactly as: y = Xβ + ε\n\n")
cat("2. The COLUMN OF 1s creates the intercept β₀.\n")
cat("   Without it, we'd force the line through the origin!\n\n")
cat("3. X'X captures PREDICTOR-TO-PREDICTOR relationships (3×3 square matrix).\n")
cat("   This is what we invert to solve the system.\n\n")
cat("4. X'y captures PREDICTOR-TO-OUTCOME relationships (3×1 vector).\n")
cat("   This is the 'signal' from our data.\n\n")
cat("5. β = (X'X)⁻¹X'y is the EXACT solution that minimizes squared errors.\n")
cat("   Not an approximation - it's the mathematical answer!\n\n")
cat("6. This understanding helps you grasp:\n")
cat("   - Multicollinearity (when X'X is nearly non-invertible)\n")
cat("   - Ridge regression: β = (X'X + λI)⁻¹X'y\n")
cat("   - Other advanced regression techniques\n\n")
# ==============================================================================
# TRY IT YOURSELF
# ==============================================================================
cat("\n")
cat("TRY IT YOURSELF!\n")
cat("================\n\n")
cat("Challenge: Create a dataset with just ONE predictor (only sqft).\n")
cat("Build the X matrix, calculate β, and verify it matches lm().\n\n")
cat("Bonus: What happens if you forget the column of 1s?\n")
cat("Try it and see how the coefficient changes!\n\n")
cat("Script complete!\n")
################################################################################
# Multiple Linear Regression: The Matrix Algebra Behind lm()
################################################################################
# Create dataset
sqft <- c(1000, 1500, 1200, 1800, 1400, 1600, 1100, 1700)
bedrooms <- c(2, 3, 2, 4, 3, 3, 2, 4)
price <- c(200, 280, 240, 320, 270, 300, 230, 310)  # in thousands
houses <- data.frame(sqft, bedrooms, price)
houses
# ==============================================================================
# Method 1: Using lm()
# ==============================================================================
model <- lm(price ~ sqft + bedrooms, data = houses)
summary(model)
coef(model)
# ==============================================================================
# Method 2: Matrix algebra approach
# ==============================================================================
# Build design matrix X (include column of 1s for intercept!)
X <- cbind(1, sqft, bedrooms)
X
dim(X)  # 8 observations × 3 coefficients
# Create outcome vector y
y <- price
y
# Calculate X'X (how predictors relate to each other)
XtX <- t(X) %*% X
XtX
# Verify what X'X contains
sum(sqft)  # equals XtX[1,2]
sum(sqft^2)  # equals XtX[2,2]
sum(sqft * bedrooms)  # equals XtX[2,3]
# Calculate X'y (how predictors relate to outcome)
Xty <- t(X) %*% y
Xty
# Verify what X'y contains
sum(price)  # equals Xty[1]
sum(sqft * price)  # equals Xty[2]
sum(bedrooms * price)  # equals Xty[3]
# Solve for β using the formula: β = (X'X)⁻¹X'y
XtX_inv <- solve(XtX)  # Inverse of X'X
beta <- XtX_inv %*% Xty
beta
# Or in one step:
beta <- solve(t(X) %*% X) %*% t(X) %*% y
beta
# ==============================================================================
# Verify results match
# ==============================================================================
# Compare coefficients
comparison <- data.frame(
lm_result = coef(model),
our_beta = as.vector(beta)
)
comparison
# Check if equal (within numerical precision)
all.equal(coef(model), as.vector(beta))
# ==============================================================================
# Make predictions
# ==============================================================================
# Predict for: 1600 sqft, 3 bedrooms
# Using lm()
predict(model, data.frame(sqft = 1600, bedrooms = 3))
# Using our beta (manual)
new_house <- c(1, 1600, 3)  # Include 1 for intercept
sum(new_house * beta)
# Using matrix multiplication
new_house_matrix <- matrix(c(1, 1600, 3), nrow = 1)
new_house_matrix %*% beta
# ==============================================================================
# Summary: The complete formula in one line
# ==============================================================================
# β = (X'X)⁻¹X'y
solve(t(X) %*% X) %*% t(X) %*% y
model
